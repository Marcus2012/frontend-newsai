# Copy these into Vercel Environment Variables (Production)
# Do NOT commit real secrets. Replace values accordingly.

# NEXT_PUBLIC_STRAPI_URL should point to your Strapi API (no /admin)
NEXT_PUBLIC_STRAPI_URL="https://your-strapi.example.com"
# Remove NEXT_PUBLIC_API_ENDPOINT — frontend now talks directly to Strapi
# NEXT_PUBLIC_API_ENDPOINT="https://newsai-backend-855091632688.us-east4.run.app"
# If your Strapi requires a token to fetch private content set it here
NEXT_PUBLIC_STRAPI_TOKEN=""

# Optional: alternate endpoints
NEXT_PUBLIC_STRAPI_PRD="https://your-strapi.example.com/admin"
